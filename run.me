#!/bin/bash

set -e

declare      order=(machine variant)
declare -A configs=( [machine]="iot-gate-imx8 iot-gate-imx8plus iotdin-imx8p mcm-imx8m-plus som-imx8m-plus ucm-imx8m-plus ucm-imx8m-plus-sbev" [variant]="d2d4 d1d8" )
declare -A results=()

function iot-gate-imx8_func() {
	configs=( [variant]="otg1_host otg1_device" )
}

function select_function() {

    select_string=${select_array[@]}
    PS3="${1}  (Ctrl^C -- exit) : "
    select i in $select_string; do
        [[ -z ${i} ]] && echo "Invalid option -(" || case $i in
        default)
        break
        ;;
        *)
        _select=${i}
	command -v ${_select}_func && ${_select}_func || true
        break
        ;;
        esac
    done # select
}

function get_config() {

for _cfg in ${order[@]}; do

    _select=""
    declare -a select_array=${configs[${_cfg}]}
    select_function ${_cfg}
    declare -a select_array=${options[${_select}]}
    select_function ${_select}
    results[${_cfg}]=${_select}

done

}

get_config


pushd /tmp >/dev/null

file="https://github.com/compulab-yokneam/bin/raw/refs/heads/compulab-firmware/${results['machine']}/flash.bin.${results['variant']}.xz"
folder="bootloader/${results['machine']}/${results['variant']}"

mkdir -p ${folder}
rm -rf ${folder}/*
wget --no-check-certificate -q -O - ${file} | xz -dc - > ${folder}/flash.bin
ln -sf ${folder}/flash.bin /tmp/flash.bin

cat << eof

Downloaded: ${file}
Location: /tmp/flash.bin -> $(readlink -e /tmp/flash.bin)

eof

CL_UBOOT=cl-uboot.work
which ${CL_UBOOT} &>/dev/null && {
	cat $(which ${CL_UBOOT}) | grep -q SRC && P=SRC || P=IMX_BOOT
cat << eof

Issue this command and update the device booltlader:
	${P}=$(readlink -e /tmp/flash.bin) cl-uboot

eof
} || true

popd >/dev/null
