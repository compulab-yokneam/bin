# Run the script. If it exits with 0, proceed. If not, jump to the end label.
PROGRAM!="/opt/iot-gate-imx8plus/shell/iotg_id.sh", GOTO="skip_device_rules"

# IE-M2M2 with MESH SILAB
SUBSYSTEM=="usb-serial", ACTION=="add", DRIVERS=="cp210x", DEVPATH=="/devices/platform/soc@0/32f10108.usb/38200000.usb/xhci-hcd.2.auto/usb3/3-1/3-1.2/3-1.2:1.0/tty/ttyUSB*", SYMLINK+="ttyIEX"

# End label
LABEL="skip_device_rules"
