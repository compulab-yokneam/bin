# TTYs
SUBSYSTEM=="tty", KERNELS=="30880000.serial", DRIVERS=="imx-uart", SYMLINK+="ttyRS485_A"
SUBSYSTEM=="tty", KERNELS=="30860000.serial", DRIVERS=="imx-uart", SYMLINK+="ttyRS485_B"

# CAN
SUBSYSTEM=="net", ACTION=="add", DEVPATH=="/devices/platform/soc@0/30800000.bus*/308d0000.can/net/can?", NAME="canA"
SUBSYSTEM=="net", ACTION=="add", DEVPATH=="/devices/platform/soc@0/30800000.bus*/308c0000.can/net/can?", NAME="canB"

# Cellular Modem: 1bc7:1031 Telit Wireless Solutions LE910C4-WWX
SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="1bc7", ATTRS{idProduct}=="1031", DEVPATH=="/devices/platform/soc@0/32f10108.usb/38200000.usb/xhci-hcd.2.auto/usb3/3-1/3-1.2/3-1.2:1.0/ttyUSB*/tty/ttyUSB*", SYMLINK+="ttyModemQCDM", MODE="0660"
SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="1bc7", ATTRS{idProduct}=="1031", DEVPATH=="/devices/platform/soc@0/32f10108.usb/38200000.usb/xhci-hcd.2.auto/usb3/3-1/3-1.2/3-1.2:1.1/ttyUSB*/tty/ttyUSB*", SYMLINK+="ttyModemAT1", MODE="0660"
SUBSYSTEM=="tty", ACTION=="add", ATTRS{idVendor}=="1bc7", ATTRS{idProduct}=="1031", DEVPATH=="/devices/platform/soc@0/32f10108.usb/38200000.usb/xhci-hcd.2.auto/usb3/3-1/3-1.2/3-1.2:1.2/ttyUSB*/tty/ttyUSB*", SYMLINK+="ttyModemAT2", MODE="0660"
